{
  "manifest_version": 3,
  "name": "SwiftDownload",
  "version": "1.1.0",
  "description": "Downloads files, media, HLS/DASH streams and magnet links with the SwiftDownload desktop download manager.",
  "key": "",
  "minimum_chrome_version": "115",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "magnet.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "classify.js",
        "adapters.js",
        "detector.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "contextMenus",
    "downloads.ui",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "SwiftDownload",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_permissions": [
    "cookies"
  ]
}
